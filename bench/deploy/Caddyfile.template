# Generated by deploy/caddy-setup.sh. Edits here are overwritten on the next run.
#
# Caddy terminates TLS on the public interface and proxies to the API, which
# stays bound to 127.0.0.1. So the thing exposed to the internet is Caddy, and
# the origin remains unreachable from outside exactly as it was behind the
# tunnel.

__HOSTNAME__ {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8090 {
		# Overwrite these two, never append.
		#
		# Caddy's default is to *append* the peer to whatever X-Forwarded-For
		# the client sent. The origin resolves a chain by taking the left-most
		# public entry, which is correct behind Cloudflare, where the edge owns
		# the header. Behind an appending proxy it is an impersonation bug: a
		# client sending `X-Forwarded-For: 93.184.216.34` produces the chain
		# `93.184.216.34, <their real address>`, the origin reads the first
		# one, and they are now whoever they said they were. Since identity is
		# the access control here, that is read access to someone else's
		# submissions.
		#
		# {remote_host} is the TCP peer. The client cannot write it.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}

		# Proof the request arrived through this proxy rather than straight at
		# the origin. Set, not added, so a client sending its own guess has it
		# replaced. Must equal BENCH_TRUST_SECRET in the API's env file; both
		# are written by caddy-setup.sh from one generated value.
		header_up __TRUST_HEADER__ __SECRET__
	}
}
